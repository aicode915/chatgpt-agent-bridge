# 复制为 .env 并填入真实值（.env 已被 .gitignore，不会提交）
#
# ChatGPT 连接器绑定的隧道 id：
#   在 https://platform.openai.com/settings/organization/tunnels 查看（或问我帮你查）
CONTROL_PLANE_TUNNEL_ID=tunnel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 运行时控制面 API key：
#   在 https://platform.openai.com/settings/organization/api-keys 生成/复制
CONTROL_PLANE_API_KEY=sk-...
